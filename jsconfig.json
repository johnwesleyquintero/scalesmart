{
  "compilerOptions": {
    "baseUrl": ".", // Set base URL to project root
    "paths": {
      "@/*": ["src/*"], // Map @/ to src/
      "@/components/*": ["src/components/*"],
      "@/lib/*": ["src/lib/*"], // Corrected: Map @/lib to src/lib/
      "@/app/components/*": ["src/app/components/*"],
      "@/hooks/*": ["src/hooks/*"] // Map @/hooks to src/hooks
    }
  },
  "include": ["**/*.js", "**/*.jsx", "**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
