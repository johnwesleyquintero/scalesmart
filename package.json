  "scripts": {
    "dev:next": "next dev",
    "dev": "next dev --turbo",
    "build": "npx cross-env NODE_ENV=production next build",
    "start": "cross-env NODE_ENV=production next start",
    "format": "prettier --write . --log-level warn",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "deploy": "npx vercel deploy",
    "deploy:prod": "npx vercel --prod",
    "lint": "eslint --config eslint.config.mjs .",
    "lint:npx": "npx eslint .",
    "lint:fix": "npm run lint -- --fix",
    "clean": "npx cross-env node -e \"const fs=require('fs'); try{fs.rmSync('.next',{recursive:true,force:true})}catch(e){}\"",
    "post-build": "npm run clean-cache",
    "clean-cache": "npx cross-env node -e \"const fs=require('fs'); const path=require('path'); ['.next/cache/webpack','.next/cache/.tsbuildinfo'].forEach(p=>{try{fs.rmSync(p,{recursive:true,force:true})}catch(e){}})\"",
    "check": "node scripts/code-checker.mjs",
    "git": "node scripts/git-commit.mjs"
  },
