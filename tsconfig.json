{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "baseUrl": "./src",
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noEmit": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "jsxImportSource": "react",
    "incremental": true,
    "outDir": "dist",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@/lib/*": ["./lib/*"],
      "@/components/*": ["./components/*"],
      "@/app/components/*": ["./app/components/*"],
      "@/hooks/*": ["./app/hooks/*"] // Ensure this line exists
    }
  },
  "types": ["@testing-library/jest-dom", "node"],
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    ".next/types/**/*.ts",
    "src/__tests__/setup.ts",
    "src/**/*",
    "types/**/*.d.ts",
    "test/**/*",
    "src/types/**/*",
    "src/types/index.d.ts"
  ],
  "typeRoots": ["./src/types", "./node_modules/@types"],
  "exclude": [
    ".next",
    "jest.config.js",
    "__mocks__/svg.js",
    "coverage/lcov-report/*",
    "dist/lib/models.js",
    "dist/lib/mongodb.js",
    "dist/scripts/*",
    "eslint.config.js",
    "jest.setup.js",
    "next.config.js",
    "tailwind.config.js"
  ]
}
